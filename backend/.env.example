# Puerto en el que escucha el servidor. En Fly lo fija el Dockerfile (8080);
# en local podés dejarlo vacío para usar el default (3000).
PORT=

# Cadena de conexión a MongoDB (Atlas en producción, local o mongodb-memory-server en tests).
MONGO_URI=

# Cadena de conexión a la base de producción. Solo la usan scripts manuales en
# src/scripts/*, nunca el servidor en runtime. No hace falta en Fly secrets.
MONGO_URI_PROD=

# Secreto para firmar/verificar JWTs de sesión.
JWT_SECRET=

# URL pública del frontend. Se usa para construir links (reset de contraseña,
# retorno de checkout de MercadoPago) y, si se restringe CORS, como origen permitido.
FRONTEND_URL=

# SMTP para el envío de emails (reset de contraseña, notificaciones). Opcional:
# sin estas variables, los emails se loguean a consola en vez de enviarse.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Credenciales de MercadoPago. Opcional: sin ambas, la integración de pagos
# queda deshabilitada y el flujo de billing sigue en modo manual.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Secreto compartido con el cron externo que dispara
# POST /billing/cron/reconcile-pending (header x-cron-secret).
CRON_SECRET=
