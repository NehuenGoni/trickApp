{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",   
    "outDir": "./dist",    
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "src/__tests__"],
  // ts-node solo compila los archivos alcanzables por import, así que sin esto
  // no carga `src/types/express.d.ts` y falla al usar `req.authUser`.
  "ts-node": { "files": true }
}